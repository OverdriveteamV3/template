# Public Supabase settings from a new Over Drive project. Do not use another product's project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose this in client code or website settings.
SUPABASE_SECRET_KEY=

# Multi-tenant host. Use localhost for development and book.overdriveio.com in production.
ROOT_DOMAIN=localhost
PLATFORM_HOSTS=localhost,127.0.0.1
# Optional dedicated deployment. Locks every request to one tenant slug.
TENANT_LOCK_SLUG=
ALLOWED_HOSTS=

# Generate these locally. Do not commit real values.
PREVIEW_TOKEN_SECRET=
CRON_SECRET=
AUTH_TRANSFER_SECRET=

# Verified Over Drive sender. Tenant addresses are reply-to until their domain is verified.
RESEND_API_KEY=
EMAIL_FROM="Over Drive <bookings@mail.overdriveio.com>"

# One-time platform owner promotion after that person has signed up.
PLATFORM_OWNER_EMAIL=
